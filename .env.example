# Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# These are used server-side (Edge Functions) only — never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Secret token shared between the Python AI worker and the receive-detection edge function
DETECTION_API_SECRET=your-random-secret-token-here

# X/Twitter API credentials (for post-to-twitter edge function)
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# Firecrawl (for scrape-politicians edge function)
FIRECRAWL_API_KEY=your-firecrawl-api-key
